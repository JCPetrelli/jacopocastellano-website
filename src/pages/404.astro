---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// Slugs that exist today, so old links can be sent to the matching page.
const portfolioSlugs = (await getCollection('portfolio')).map((p) => p.id);
const blogSlugs = (await getCollection('blog')).map((p) => p.id);
---

<BaseLayout title="Page Not Found" noindex={true}>
  <section class="not-found">
    <div class="container container-narrow">
      <p class="error-code">404</p>
      <h1>Page Not Found</h1>
      <p class="message">The page you're looking for doesn't exist.</p>
      <a href="/" class="btn">Go Home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
    padding: var(--space-2xl) 0;
    min-height: 60vh;
    display: flex;
    align-items: center;
  }

  .error-code {
    font-size: 6rem;
    font-weight: 700;
    color: var(--color-text-subtle);
    line-height: 1;
    margin-bottom: var(--space-md);
  }

  h1 {
    margin-bottom: var(--space-md);
  }

  .message {
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
  }
</style>

<script is:inline define:vars={{ portfolioSlugs, blogSlugs }}>
  // GitHub Pages serves this page for every unknown URL, so old links are redirected here.
  const redirects = {
    '/index.php': '/',
    '/index_old.php': '/',
    '/contact.php': '/contact/',
    '/lottie.html': '/',
    '/mwt': '/portfolio/video-mapping-mwt/',
    '/die-wahlverwandtschaften': '/portfolio/elective-affinities/',
  };
  // Prefixes of the old WordPress site and the old classicaldepicted blog, which are gone.
  const legacyPrefixes = ['/classicaldepicted', '/category/', '/author/', '/tag/', '/page/', '/wp-content/', '/fonts/'];

  const path = decodeURIComponent(window.location.pathname).toLowerCase().replace(/\/+$/, '') || '/';
  // /projects/carmina_burana.html, /stabat_mater.php, /stabat-mater -> stabat-mater
  const slug = path.split('/').pop().replace(/\.(html?|php)$/, '').replace(/_/g, '-');
  const segments = path.split('/').filter(Boolean).length;

  let target = null;
  if (path in redirects) target = redirects[path];
  else if (portfolioSlugs.includes(slug) && (segments === 1 || path.startsWith('/projects/'))) target = `/portfolio/${slug}/`;
  else if (blogSlugs.includes(slug) && segments === 1) target = `/blog/${slug}/`;
  else if (legacyPrefixes.some((p) => path.startsWith(p))) target = '/';
  else if (path.endsWith('.php') || path.startsWith('/projects/')) target = '/';
  else if (segments === 1 && /^[a-z0-9-]+$/.test(slug)) target = '/'; // an old blog post that no longer exists

  if (target && target !== window.location.pathname) window.location.replace(target);
</script>
