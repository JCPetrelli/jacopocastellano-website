---
// JC-827 — blog list.
import SiteLayout from '../../layouts/redesign/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../../utils/readingTime';
import { P, fmtDay } from '../../layouts/redesign/paths';
import '../../styles/redesign/blog.css';
import Framed from '../../components/redesign/Framed.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [lead, ...rest] = posts;
---
<SiteLayout title="Blog" description="Thoughts on software engineering, video design, and the creative process.">
  <section class="pg-hero">
    <div class="wrap">
      <span class="label">Writing · {posts.length} posts</span>
      <h1>Writing about code, tools, and creative projects.</h1>
    </div>
  </section>

  {lead && (
    <section class="pg-body">
      <div class="wrap">
        <a href={`${P}/blog/${lead.id}/`} class="bl-lead">
          {lead.data.image && <Framed src={lead.data.image} alt="" ratio={1.9} class="media" eager />}
          <div>
            <span class="label">Latest · {fmtDay(lead.data.date)} · {getReadingTime(lead.body ?? '')} min</span>
            <h2>{lead.data.title}</h2>
            <p>{lead.data.description}</p>
          </div>
        </a>
      </div>
    </section>
  )}

  <section style="padding-top:0">
    <div class="wrap rows">
      {rest.map((post) => (
        <a href={`${P}/blog/${post.id}/`} class="bl-row">
          <span class="label">{fmtDay(post.data.date)}</span>
          <div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </div>
          <span class="label bl-min">{getReadingTime(post.body ?? '')} min</span>
        </a>
      ))}
    </div>
  </section>
</SiteLayout>
