---
// JC-827 — blog post.
import SiteLayout from '../../layouts/redesign/SiteLayout.astro';
import { getCollection, render } from 'astro:content';
import { getReadingTime } from '../../utils/readingTime';
import { P, fmtLong } from '../../layouts/redesign/paths';
import '../../styles/redesign/blog.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, tags, image } = post.data;
const related = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id && p.data.tags.some((t) => tags.includes(t)))
  .slice(0, 3);
---
<SiteLayout title={title} description={description} image={image} type="article" publishedTime={date} tags={tags}
  breadcrumbs={[{ name: 'Blog', url: '/blog/' }, { name: title, url: '' }]}>
  <article>
    <header class="pg-hero">
      <div class="wrap">
        <a href={`${P}/blog/`} class="back">&larr; Writing</a>
        <h1 class="bp-title">{title}</h1>
        <div class="pg-intro">
          <p>{description}</p>
          <div class="bp-meta">
            <span class="label"><time datetime={date.toISOString()}>{fmtLong(date)}</time> · {getReadingTime(post.body ?? '')} min read</span>
            {tags.length > 0 && <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>}
          </div>
        </div>
      </div>
    </header>

    {image && <div class="wrap bp-cover"><img src={image} alt={title} /></div>}

    <div class="wrap pg-body bp-body">
      <div class="prose"><Content /></div>
      <footer class="bp-author">
        <span class="label">Written by</span>
        <p>Jacopo Castellano</p>
        <span class="label">Senior Software Engineer &amp; Video Designer</span>
      </footer>
    </div>
  </article>

  {related.length > 0 && (
    <section class="bp-related">
      <div class="wrap">
        <div class="section-head"><h2>Related</h2></div>
        <div class="rows">
          {related.map((p) => (
            <a href={`${P}/blog/${p.id}/`} class="post">
              <span class="label">{p.data.date.getFullYear()}</span>
              <h3>{p.data.title}</h3>
              <span class="arrow">&rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</SiteLayout>
