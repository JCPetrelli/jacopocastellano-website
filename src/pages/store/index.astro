---
// JC-827 — store page.
// PRODUCTS: the gumroad-store skill edits this array.
import SiteLayout from '../../layouts/redesign/SiteLayout.astro';
import '../../styles/redesign/store.css';
import Framed from '../../components/redesign/Framed.astro';

const products = [
  {
    title: 'Christmas Loaders',
    kind: 'Animation pack',
    description: '20 looping Christmas Lottie animations for loaders and UI: bauble, snowman, Santa hat, gift, gingerbread man, tree, reindeer, snow globe, sleigh and more.',
    price: '€9',
    image: '/images/store/christmas_loaders_lottie.jpg',
    href: 'https://jacopocastellano.gumroad.com/l/christmas-lottie',
    external: true,
  },
  {
    title: 'Christmas Animated Icons & Stickers',
    kind: 'Animation pack',
    description: '30 Christmas Lottie animations: Santa, elf, penguin, nutcracker, toy train, fireplace, advent calendar, pudding, mistletoe and Merry Christmas lettering.',
    price: '€14',
    image: '/images/store/christmas_icons_lottie.jpg',
    href: 'https://jacopocastellano.gumroad.com/l/christmas-animated-icons',
    external: true,
  },
  {
    title: 'New Year Animated Icons & Stickers',
    kind: 'Animation pack',
    description: '20 New Year\'s Eve Lottie animations with no year drawn in: fireworks, champagne, midnight clock, countdown, ball drop, party items and Happy New Year lettering.',
    price: '€9',
    image: '/images/store/new_year_lottie.jpg',
    href: 'https://jacopocastellano.gumroad.com/l/new-year-lottie',
    external: true,
  },
  {
    title: 'Winter Animated Icons & Stickers',
    kind: 'Animation pack',
    description: '20 winter Lottie animations with no holiday symbols: skier, snowboarder, sled, scarf, icicles, igloo, log cabin, ski lift, arctic fox and snowy owl.',
    price: '€9',
    image: '/images/store/winter_lottie.jpg',
    href: 'https://jacopocastellano.gumroad.com/l/winter-lottie',
    external: true,
  },
  {
    title: 'Creator Countdown & CTA',
    kind: 'Animation pack',
    description: '20 Lottie animations for creators and apps, in dark and light: countdown timers, subscribe, follow, like, LIVE badge, username lower third and more.',
    price: '€9',
    image: '/images/store/creator_cta_lottie.jpg',
    href: 'https://jacopocastellano.gumroad.com/l/creator-cta-lottie',
    external: true,
  },
  {
    title: 'Cute Spooky Halloween Loaders',
    kind: 'Animation pack',
    description: '10 looping Halloween Lottie animations for page loaders and UI: pumpkin, ghost, spider, bat, cauldron, black cat, skull, tombstone, eyeball and candle.',
    price: '€7',
    image: '/images/store/halloween_lottie_loaders.jpg',
    href: 'https://jacopocastellano.gumroad.com/l/halloween-lottie',
    external: true,
  },
  {
    title: 'Orchestra Instruments',
    kind: '3D model pack',
    description: '36 orchestral instruments as 3D models: GLB, FBX, OBJ, USDZ and Blender files, at real sizes, in three detail levels.',
    price: '€29',
    image: '/images/portfolio/orchestra_instruments/all_instruments.jpg',
    href: '/orchestra-instruments/',
    external: false,
  },
  {
    title: 'Keyboards',
    kind: '3D model pack',
    description: 'Grand piano, two-manual harpsichord, fortepiano and celesta as 3D models, at real sizes, with lids, desks and pedals that move.',
    price: '€19',
    image: '/images/store/orchestra_keyboards.jpg',
    href: 'https://jacopocastellano.gumroad.com/l/keyboards',
    external: true,
  },
  {
    title: 'Bowed Strings',
    kind: '3D model pack',
    description: 'Violin, viola, cello and double bass, each with its bow, as 3D models with wood-grain textures, at real sizes.',
    price: '€12',
    image: '/images/store/orchestra_bowed_strings.jpg',
    href: 'https://jacopocastellano.gumroad.com/l/bowed-strings',
    external: true,
  },
  {
    title: 'Concert Grand Piano',
    kind: '3D model',
    description: 'A black concert grand with its bench: 88 keys, hammers, strings, dampers, and a lid, fallboard and pedals that move.',
    price: '€12',
    image: '/images/store/orchestra_grand_piano.jpg',
    href: 'https://jacopocastellano.gumroad.com/l/grand-piano',
    external: true,
  },
  {
    title: 'Two-Manual Harpsichord',
    kind: '3D model',
    description: 'A white-and-red German two-manual harpsichord with 61 notes on each manual, a gilt rose and a lid that opens.',
    price: '€9',
    image: '/images/store/orchestra_harpsichord.jpg',
    href: 'https://jacopocastellano.gumroad.com/l/harpsichord',
    external: true,
  },
  {
    title: 'Fortepiano (about 1830)',
    kind: '3D model',
    description: 'A mahogany grand fortepiano of about 1830 with 78 keys, a bird\'s-eye maple nameboard and a lyre with two pedals.',
    price: '€9',
    image: '/images/store/orchestra_fortepiano.jpg',
    href: 'https://jacopocastellano.gumroad.com/l/fortepiano',
    external: true,
  },
  {
    title: 'Concert Harp',
    kind: '3D model',
    description: 'A pedal harp with a fluted gilt column, coloured C and F strings and seven pedals that move.',
    price: '€7',
    image: '/images/store/orchestra_concert_harp.jpg',
    href: 'https://jacopocastellano.gumroad.com/l/concert-harp',
    external: true,
  },
  {
    title: 'Hurdy-Gurdy',
    kind: '3D model',
    description: 'A lute-backed hurdy-gurdy with an inlaid key box, 23 keys, a carved scroll and a wheel that turns.',
    price: '€7',
    image: '/images/store/orchestra_hurdy_gurdy.jpg',
    href: 'https://jacopocastellano.gumroad.com/l/hurdy-gurdy',
    external: true,
  },
  {
    title: 'Lottie Floating Loaders (Dark Mode)',
    kind: 'Animation pack',
    description: 'Lottie floating loaders for websites, landing pages and apps, with layers optimised to keep the files small.',
    price: '€9.99',
    image: '/images/store/lottie_floating_loaders.jpg',
    href: 'https://jacopocastellano.gumroad.com/l/lottie-floating-loaders-animation-pack',
    external: true,
  },
];

// group in the order the kinds first appear
const groups = [...new Set(products.map((p) => p.kind))].map((kind) => ({ kind, items: products.filter((p) => p.kind === kind) }));
const plural = (k: string) => k + 's';
---
<SiteLayout title="Store" description="Things I make that you can buy: 3D model packs and animation packs.">
  <section class="pg-hero">
    <div class="wrap">
      <span class="label">Store</span>
      <h1>Things I make<br />that you can buy.</h1>
      <div class="pg-intro">
        <p>3D model packs and animation packs. Checkout and downloads are handled by Gumroad.</p>
        <nav class="st-jump" aria-label="Categories">
          {groups.map((g) => <a class="pill" href={`#${g.kind.toLowerCase().replace(/\W+/g, '-')}`}>{plural(g.kind)} <span class="st-count">{g.items.length}</span></a>)}
        </nav>
      </div>
    </div>
  </section>

  {groups.map((g, gi) => (
    <section class:list={['st-group', { 'on-dark': gi === 1 }]} id={g.kind.toLowerCase().replace(/\W+/g, '-')}>
      <div class="wrap">
        <div class="section-head"><h2>{plural(g.kind)}</h2><span class="label">{String(g.items.length).padStart(2, '0')}</span></div>
        {g.items.map((p) => (
          <a class="st-item" href={p.href} target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener' : undefined}>
            <Framed src={p.image} alt="" ratio={16 / 9} class="media" />
            <div class="st-body">
              <h3>{p.title}</h3>
              <p>{p.description}</p>
            </div>
            <div class="st-buy">
              <span class="st-price">{p.price}</span>
              <span class="pill">{p.external ? 'On Gumroad' : 'Details'} &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}
</SiteLayout>
