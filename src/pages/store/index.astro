---
import BaseLayout from '../../layouts/BaseLayout.astro';

// One entry per thing for sale. `href` is its page on this site, or its Gumroad page (then `external`).
const products = [
  {
    title: 'Creator Countdown & CTA',
    kind: 'Animation pack',
    description: '20 Lottie animations for creators and apps, in dark and light: countdown timers, subscribe, follow, like, LIVE badge, username lower third and more.',
    price: '€9',
    image: '/images/store/creator_cta_lottie.jpg',
    href: 'https://jacopocastellano.gumroad.com/l/creator-cta-lottie',
    external: true,
  },
  {
    title: 'Cute Spooky Halloween Loaders',
    kind: 'Animation pack',
    description: '10 looping Halloween Lottie animations for page loaders and UI: pumpkin, ghost, spider, bat, cauldron, black cat, skull, tombstone, eyeball and candle.',
    price: '€7 · €1 until 2 Nov',
    image: '/images/store/halloween_lottie_loaders.jpg',
    href: 'https://jacopocastellano.gumroad.com/l/halloween-lottie',
    external: true,
  },
  {
    title: 'Orchestra Instruments',
    kind: '3D model pack',
    description: '36 orchestral instruments as 3D models: GLB, FBX, OBJ, USDZ and Blender files, at real sizes, in three detail levels.',
    price: '€29',
    image: '/images/portfolio/orchestra_instruments/all_instruments.jpg',
    href: '/orchestra-instruments/',
    external: false,
  },
  {
    title: 'Keyboards',
    kind: '3D model pack',
    description: 'Grand piano, two-manual harpsichord, fortepiano and celesta as 3D models, at real sizes, with lids, desks and pedals that move.',
    price: '€19',
    image: '/images/store/orchestra_keyboards.jpg',
    href: 'https://jacopocastellano.gumroad.com/l/keyboards',
    external: true,
  },
  {
    title: 'Bowed Strings',
    kind: '3D model pack',
    description: 'Violin, viola, cello and double bass, each with its bow, as 3D models with wood-grain textures, at real sizes.',
    price: '€12',
    image: '/images/store/orchestra_bowed_strings.jpg',
    href: 'https://jacopocastellano.gumroad.com/l/bowed-strings',
    external: true,
  },
  {
    title: 'Concert Grand Piano',
    kind: '3D model',
    description: 'A black concert grand with its bench: 88 keys, hammers, strings, dampers, and a lid, fallboard and pedals that move.',
    price: '€12',
    image: '/images/store/orchestra_grand_piano.jpg',
    href: 'https://jacopocastellano.gumroad.com/l/grand-piano',
    external: true,
  },
  {
    title: 'Two-Manual Harpsichord',
    kind: '3D model',
    description: 'A white-and-red German two-manual harpsichord with 61 notes on each manual, a gilt rose and a lid that opens.',
    price: '€9',
    image: '/images/store/orchestra_harpsichord.jpg',
    href: 'https://jacopocastellano.gumroad.com/l/harpsichord',
    external: true,
  },
  {
    title: 'Fortepiano (about 1830)',
    kind: '3D model',
    description: 'A mahogany grand fortepiano of about 1830 with 78 keys, a bird\'s-eye maple nameboard and a lyre with two pedals.',
    price: '€9',
    image: '/images/store/orchestra_fortepiano.jpg',
    href: 'https://jacopocastellano.gumroad.com/l/fortepiano',
    external: true,
  },
  {
    title: 'Concert Harp',
    kind: '3D model',
    description: 'A pedal harp with a fluted gilt column, coloured C and F strings and seven pedals that move.',
    price: '€7',
    image: '/images/store/orchestra_concert_harp.jpg',
    href: 'https://jacopocastellano.gumroad.com/l/concert-harp',
    external: true,
  },
  {
    title: 'Hurdy-Gurdy',
    kind: '3D model',
    description: 'A lute-backed hurdy-gurdy with an inlaid key box, 23 keys, a carved scroll and a wheel that turns.',
    price: '€7',
    image: '/images/store/orchestra_hurdy_gurdy.jpg',
    href: 'https://jacopocastellano.gumroad.com/l/hurdy-gurdy',
    external: true,
  },
  {
    title: 'Lottie Floating Loaders (Dark Mode)',
    kind: 'Animation pack',
    description: 'Lottie floating loaders for websites, landing pages and apps, with layers optimised to keep the files small.',
    price: '€9.99',
    image: '/images/store/lottie_floating_loaders.jpg',
    href: 'https://jacopocastellano.gumroad.com/l/lottie-floating-loaders-animation-pack',
    external: true,
  },
];
---

<BaseLayout title="Store" description="Things I make that you can buy: 3D model packs and animation packs.">
  <section class="store">
    <div class="container">
      <header class="page-header">
        <h1>Store</h1>
        <p class="page-description">Things I make that you can buy. Checkout and downloads are handled by Gumroad.</p>
      </header>

      <div class="store-grid">
        {products.map((p) => (
          <a class="store-card" href={p.href} target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener' : undefined}>
            <img src={p.image} alt={p.title} loading="lazy" />
            <div class="store-card-body">
              <span class="store-kind">{p.kind}</span>
              <h2>{p.title}</h2>
              <p>{p.description}</p>
              <span class="store-price">{p.price}{p.external && <span class="store-where"> · on Gumroad</span>}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .store { padding-top: var(--space-xl); padding-bottom: var(--space-2xl); }
  .page-header { max-width: var(--container-narrow); margin-bottom: var(--space-xl); }
  .page-description { font-size: 1.25rem; color: var(--color-text-muted); margin-top: var(--space-md); }
  .store-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-lg); }
  .store-card { display: block; border: 1px solid var(--color-border); background: var(--color-bg-alt); color: inherit; text-decoration: none; transition: border-color var(--transition-base); }
  .store-card:hover { border-color: var(--color-text-subtle); }
  .store-card img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .store-card-body { padding: var(--space-lg); display: flex; flex-direction: column; gap: var(--space-sm); }
  .store-kind { font-size: 0.75rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-subtle); }
  .store-card h2 { font-size: 1.5rem; margin: 0; }
  .store-card p { color: var(--color-text-muted); margin: 0; line-height: 1.6; }
  .store-price { font-size: 1.125rem; font-weight: 600; margin-top: var(--space-sm); }
  .store-where { font-size: 0.875rem; font-weight: 400; color: var(--color-text-subtle); }
  .store-card img { background: #000; }
  @media (max-width: 1000px) { .store-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .store-grid { grid-template-columns: 1fr; } }
</style>
