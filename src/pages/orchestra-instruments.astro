---
// JC-827 — Orchestra Instruments product page, redesign.
import SiteLayout from '../layouts/redesign/SiteLayout.astro';
import { P } from '../layouts/redesign/paths';
import '../styles/redesign/product.css';

const buy = 'https://jacopocastellano.gumroad.com/l/orchestra-instruments';
const img = '/images/portfolio/orchestra_instruments';
const price = '29';
const families = [
  { name: 'Strings', items: 'violin, viola, cello, double bass, harp' },
  { name: 'Woodwind', items: 'piccolo, flute, oboe, cor anglais, clarinet, bass clarinet, bassoon, contrabassoon' },
  { name: 'Brass', items: 'french horn, trumpet, trombone, bass trombone, tuba' },
  { name: 'Percussion', items: 'timpani, bass drum, snare drum, cymbals, triangle, tambourine, tam-tam, glockenspiel, xylophone, marimba, vibraphone, tubular bells' },
  { name: 'Folk strings', items: 'mandolin, hurdy-gurdy' },
  { name: 'Keyboards', items: 'celesta, harpsichord, fortepiano, grand piano' },
];
const facts = [
  { value: '36', label: 'instruments' },
  { value: '5', label: 'formats: GLB, FBX, OBJ, USDZ, Blender' },
  { value: '3', label: 'detail levels each' },
  { value: '1:1', label: 'real sizes, in metres' },
];
const gallery = ['grand_piano.jpg', 'harpsichord.jpg', 'fortepiano.jpg', 'harp.jpg', 'hurdy_gurdy.jpg', 'vibraphone.jpg', 'french_horn.jpg', 'trumpet.jpg', 'tuba.jpg', 'grand_piano_views.jpg'];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Orchestra Instruments: 36 3D models of the symphony orchestra',
  description: '36 orchestral instruments as 3D models in GLB, FBX, OBJ, USDZ and Blender formats, at real sizes, in three detail levels.',
  image: new URL(`${img}/all_instruments.jpg`, Astro.site).toString(),
  brand: { '@type': 'Person', name: 'Jacopo Castellano' },
  offers: { '@type': 'Offer', price: price, priceCurrency: 'EUR', availability: 'https://schema.org/InStock', url: buy },
};
---
<SiteLayout
  title="Orchestra Instruments: 36 3D models"
  description="36 orchestral instruments as 3D models: GLB, FBX, OBJ, USDZ and Blender files, real sizes, three detail levels, free updates."
  image={`${img}/all_instruments.jpg`}
  breadcrumbs={[{ name: 'Store', url: '/store/' }, { name: 'Orchestra Instruments', url: '' }]}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <section class="pg-hero">
    <div class="wrap">
      <a href={`${P}/store/`} class="back">&larr; Store</a>
      <span class="label oi-kicker">3D model pack · version 2.0</span>
      <h1 class="oi-title">Orchestra Instruments</h1>
      <div class="pg-intro">
        <p>Every instrument of the symphony orchestra, from the violin to the tubular bells, with a concert grand piano as the centrepiece. 36 models at real sizes, in one style.</p>
        <div class="oi-buy">
          <span class="oi-price">€{price}</span>
          <a href={buy} class="pill" target="_blank" rel="noopener">Buy on Gumroad &rarr;</a>
          <span class="label">One payment. Later versions are free.</span>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap oi-video">
    <video controls muted playsinline preload="metadata" poster={`${img}/cover_all_instruments.jpg`}>
      <source src="/videos/orchestra-instruments-promo.mp4" type="video/mp4" />
    </video>
  </div>

  <section class="oi-facts-band">
    <ul class="wrap oi-facts">
      {facts.map((f) => <li><strong>{f.value}</strong><span class="label">{f.label}</span></li>)}
    </ul>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="section-head"><h2>What you get</h2></div>
      <dl class="rows oi-families">
        {families.map((f) => <div><dt class="label">{f.name}</dt><dd>{f.items}</dd></div>)}
      </dl>
      <p class="oi-aside">Bows, sticks, mallets, beaters and the piano bench are included as separate objects.</p>
    </div>
  </section>

  <section class="on-dark">
    <div class="wrap oi-two">
      <div>
        <span class="label">Formats</span>
        <ul class="oi-list">
          <li>GLB, FBX, OBJ and USDZ for every instrument, plus the Blender file.</li>
          <li>USDZ opens in Quick Look on a Mac, iPhone or iPad: put the instrument in your room at real size.</li>
          <li>Three detail levels: full, about 45 % and about 18 % of the triangles.</li>
          <li>870,042 triangles in all at full detail. The lightest model has 1,432, the grand piano 100,182.</li>
          <li>A 38-page PDF catalogue with every instrument's size, counts and parts.</li>
        </ul>
      </div>
      <div>
        <span class="label">Made to be animated</span>
        <p class="oi-text">Each instrument is split into named parts under one parent. On 13 of them the parts that move have their origin on the hinge or slide line: the trombones' slides, the trumpet's pistons, the piano's lid, fallboard, music desk and pedals, the harp's seven pedals. Nothing is rigged, so you animate them your way.</p>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap oi-gallery">
      {gallery.map((g) => <img src={`${img}/${g}`} alt="Orchestra Instruments render" loading="lazy" class={g.endsWith('_views.jpg') ? 'wide' : undefined} />)}
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap oi-two">
      <div>
        <span class="label">Honest notes</span>
        <ul class="oi-list">
          <li>The models are stylised, not engineering copies. Woodwind key mechanisms and brass tubing are simplified.</li>
          <li>Wood grain is an image texture on the bowed strings, the harp, the wooden bars, the keyboards, the mandolin and the hurdy-gurdy. Everything else uses plain materials.</li>
          <li>The lower detail levels are made automatically.</li>
          <li>Every file was re-imported and checked in Blender, and the FBX and OBJ files were opened in TouchDesigner at real size. If a file misbehaves in your program, <a href={`${P}/contact/`}>write to me</a>.</li>
          <li>No real maker's name or logo appears anywhere.</li>
        </ul>
      </div>
      <div>
        <span class="label">Licence</span>
        <p class="oi-text">Use the models in any number of your own projects, personal or commercial. You may not resell or share the model files themselves. One purchase per person. The full text is in the download.</p>
      </div>
    </div>
  </section>

  <section class="oi-end">
    <div class="wrap">
      <h2>36 instruments, €{price}.</h2>
      <div class="oi-end-actions">
        <a href={buy} class="pill" target="_blank" rel="noopener">Buy on Gumroad &rarr;</a>
        <a href={`${P}/portfolio/orchestra-instruments/`} class="pill">How it was made</a>
      </div>
      <p class="label">Checkout and download are handled by Gumroad.</p>
    </div>
  </section>
</SiteLayout>
