---
// JC-827 — homepage.
// Design notes in src/styles/redesign/DESIGN_NOTES.md.
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/redesign/SiteLayout.astro';
import { P } from '../layouts/redesign/paths';
import WorkList from '../components/redesign/WorkList.astro';

const featured = (await getCollection('portfolio'))
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()); // all featured projects (hover list)

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

const ventures = [
  { tag: 'Audiovisual duo', name: 'Doppelganger', url: 'https://www.doppelganger.mov/', host: 'doppelganger.mov',
    text: 'Berlin-based duo creating audiovisual performances and installations.' },
  { tag: 'Classical music', name: 'Concert Programs', url: 'https://concertprograms.eu/', host: 'concertprograms.eu',
    text: 'Free listening guides for every concert of the Berliner Philharmoniker, Wiener Philharmoniker, Royal Concertgebouw Orchestra and London Symphony Orchestra.' },
  { tag: 'Automation & AI', name: 'Bamboo Flags', url: 'https://www.bambooflags.com/', host: 'bambooflags.com',
    text: 'Automation and AI solutions for growing companies. Web development, process optimization, and intelligent systems that help businesses scale efficiently.' },
];

---
<SiteLayout title="Senior Software Engineer & Video Designer" overHero>
  <section class="hero" style="padding:0">
    <div id="rise-bg" class="hero-bg" aria-hidden="true"></div>
    <canvas id="iri" aria-hidden="true"></canvas>
    <div class="hero-inner">
      <h1><span>Code</span><span>&amp; Light</span></h1>
    </div>
    <div class="hero-sub">
      <svg class="badge" viewBox="0 0 100 100" aria-hidden="true">
        <defs><path id="circ" d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0" /></defs>
        <text><textPath href="#circ">Scroll down · Scroll down · Scroll down ·</textPath></text>
      </svg>
      <p>Senior software engineer &amp; video designer. Berlin, working globally.</p>
    </div>
  </section>

  <section class="manifesto">
    <div class="wrap">
      <span class="label">Jacopo Castellano</span>
      <h2 style="margin-top:28px">AI-driven development and real-time video design.</h2>
      <div class="row">
        <p>10+ years in software engineering and video design. I build backend systems and create visuals for ballet and classical music productions.</p>
        <div class="actions">
          <a href={`${P}/portfolio/`} class="pill">View work</a>
          <a href={`${P}/contact/`} class="pill">Get in touch</a>
        </div>
      </div>
    </div>
  </section>

  <section class="on-dark">
    <div class="wrap">
      <div class="section-head"><h2>Ventures</h2></div>
      {ventures.map((v) => (
        <div class="venture">
          <span class="label">{v.tag}</span>
          <div><h3>{v.name}</h3><p>{v.text}</p></div>
          <a href={v.url} target="_blank" rel="noopener" class="pill">{v.host} &rarr;</a>
        </div>
      ))}
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head"><h2>Work</h2><a href={`${P}/portfolio/`}>All projects &rarr;</a></div>
      <WorkList items={featured} />
    </div>
  </section>

  <section class="about">
    <div class="wrap">
      <span class="label">About</span>
      <blockquote style="margin-top:28px">Software engineer. Video designer. Trained pianist.</blockquote>
      <div class="row">
        <span class="label">Software engineering · Video design · Berlin</span>
        <a href={`${P}/about/`} class="pill">Learn more</a>
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section style="padding-top:0">
      <div class="wrap">
        <div class="section-head"><h2>Writing</h2><a href={`${P}/blog/`}>All posts &rarr;</a></div>
        {posts.map((post) => (
          <a href={`${P}/blog/${post.id}/`} class="post">
            <span class="label">{fmt(post.data.date)}</span>
            <h3>{post.data.title}</h3>
            <span class="arrow">&rarr;</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {/* Hero background: "Rise" (p5 tunnel rain) by default, the iridescent shader with ?hero=iri. */}
  <script is:inline define:vars={{ iriSrc: `${P}/iridescent.js`, v: Date.now().toString(36) }}>
    (() => {
      const iri = new URLSearchParams(location.search).get('hero') === 'iri';
      document.getElementById(iri ? 'rise-bg' : 'iri').remove();
      const files = iri ? [iriSrc]
        : ['p5.min.js', 'config.js', 'tunnel.js', 'drop.js', 'ripple.js', 'splash.js', 'sketch.js'].map((f) => `/rise/${f}`);
      for (const src of files) {
        const el = document.createElement('script');
        el.src = `${src}?v=${v}`; el.async = false; // GitHub Pages caches these for 10 min
        document.body.appendChild(el);
      }
    })();
  </script>
</SiteLayout>
