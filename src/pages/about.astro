---
// JC-827 — about page.
import SiteLayout from '../layouts/redesign/SiteLayout.astro';
import '../styles/redesign/about.css';
import { P } from '../layouts/redesign/paths';

const disciplines = [
  { name: 'Software Engineering', text: 'I architect and build scalable applications, with particular expertise in backend systems, automation, and developer tooling. My approach emphasizes clean code, thoughtful architecture, and maintainable code.' },
  { name: 'AI Engineering', html: `I build tools on top of large language models and work with AI coding agents every day. I write skills, hooks and plugins for Claude Code, such as <a href="${P}/portfolio/brickwise/">Brickwise</a>, which explains a codebase as an interactive 3D brick model, and <a href="${P}/portfolio/rubricai/">Rubricai</a>, which cleans up the macOS Contacts address book. <a href="${P}/portfolio/vark/">VARK</a> uses local models to tag video collections, recognise faces and transcribe audio. The <a href="${P}/ai-digest/">AI Digest</a> on this site is synthesized automatically from dozens of news sources every 48 hours. I hold the Claude Certified Developer and Associate certifications from Anthropic.` },
  { name: 'Video Design', text: 'I create video projections and visual content for live performances, collaborating with orchestras, ballet companies, and theaters. I have created visual experiences for prestigious institutions such as the Magdeburg Opera House and Ballet, Zurich Tonhalle, Leipzig Gewandhaus, and the Colombia National Ballet.' },
  { name: 'Automotive & Embedded Systems', text: "In the automotive industry, I've worked as a Requirements Manager and Software Engineer on complex in-vehicle information and communication systems. My focus includes HMI design, requirements management, and ASPICE-compliant processes." },
  { name: 'Creative Technology', html: 'I explore the space where code meets art: interactive installations, generative visuals, and tools for other creators. My most active creative project is <a href="https://www.doppelganger.mov/" target="_blank" rel="noopener">Doppelganger</a>, a Berlin-based audiovisual duo creating performances and installations that blend live music with real-time visuals.' },
];

const skills = [
  { group: 'Languages', items: ['Python', 'JavaScript / TypeScript', 'Bash', 'SQL'] },
  { group: 'AI Tools', items: ['Claude Code', 'Cursor'] },
  { group: 'Frameworks & Tools', items: ['React / Next.js', 'Node.js', 'Flask / FastAPI', 'MySQL / SQLite', 'Git'] },
  { group: 'Design & Video', items: ['Final Cut Pro', 'TouchDesigner', 'Adobe Creative Suite', 'Figma'] },
];

const certs = [
  { name: 'Claude Certified Developer – Foundations', meta: 'Anthropic · November 2026',
    href: 'https://www.credly.com/badges/909e8d52-3d9e-4207-a7bc-e47cbd4f12b1', img: '/images/certifications/claude-certified-developer-foundations.png' },
  { name: 'Claude Certified Associate – Foundations', meta: 'Anthropic · September 2026',
    href: 'https://www.credly.com/badges/3eb661db-0a31-4dc5-be3c-59acec74fc47', img: '/images/certifications/claude-certified-associate-foundations.png' },
];
---
<SiteLayout title="About" description="Senior Software Engineer and Video Designer with a passion for elegant solutions.">
  <section class="ab-hero">
    <div class="wrap">
      <span class="label">About</span>
      <h1>Jacopo<br />Castellano</h1>
      <div class="ab-intro">
        <figure class="ab-portrait"><img src="/images/jc.webp" alt="Jacopo Castellano" width="600" height="757" /></figure>
        <p class="ab-lead">
          I'm a Senior Software Engineer and Video Designer based in Berlin.
          I specialize in AI-driven development and real-time video design, working at the
          intersection of software engineering and real-time visual systems.
        </p>
      </div>
    </div>
  </section>

  <section class="ab-background">
    <div class="wrap ab-split">
      <span class="label">Background</span>
      <div>
        <h2>My journey began with classical music.</h2>
        <p>I trained as a pianist and earned my diploma at the A. Steffani Conservatory in Castelfranco Veneto, Italy. That foundation in artistic discipline led me to video design, where I've spent over a decade creating visual experiences for ballet, opera, and orchestral productions across Europe.</p>
        <p>In parallel, I've developed deep expertise in software engineering, focusing on Python, JavaScript, and modern web technologies. My background in both software and music shapes how I approach projects.</p>
      </div>
    </div>
  </section>

  <section class="ab-do">
    <div class="wrap">
      <div class="section-head"><h2>What I do</h2></div>
      {disciplines.map((d, i) => (
        <div class="ab-row">
          <span class="label">{String(i + 1).padStart(2, '0')}</span>
          <h3>{d.name}</h3>
          {d.html ? <p set:html={d.html} /> : <p>{d.text}</p>}
        </div>
      ))}
    </div>
  </section>

  <section class="on-dark">
    <div class="wrap">
      <div class="section-head"><h2>Skills</h2></div>
      <div class="ab-skills">
        {skills.map((s) => (
          <div>
            <span class="label">{s.group}</span>
            <ul>{s.items.map((it) => <li>{it}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="ab-certs">
    <div class="wrap">
      <div class="section-head"><h2>Latest certifications</h2></div>
      {certs.map((c) => (
        <a href={c.href} target="_blank" rel="noopener" class="ab-cert">
          <img src={c.img} alt="" width="64" height="64" loading="lazy" />
          <h3>{c.name}</h3>
          <span class="label">{c.meta}</span>
          <span class="arrow">&rarr;</span>
        </a>
      ))}
    </div>
  </section>

  <section class="ab-contact">
    <div class="wrap ab-split">
      <span class="label">Contact</span>
      <div>
        <h2>Available for freelance projects and collaborations.</h2>
        <a href={`${P}/contact/`} class="pill">Get in touch</a>
      </div>
    </div>
  </section>
</SiteLayout>
