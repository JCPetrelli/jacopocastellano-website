---
// JC-827 — archived AI Digest edition.
import SiteLayout from '../../../layouts/redesign/SiteLayout.astro';
import DigestEdition from '../../../components/redesign/DigestEdition.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  return (await getCollection('aiDigest')).map((entry) => ({ params: { date: entry.id }, props: { entry } }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'aiDigest'> };
const d = entry.data;
const label = d.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<SiteLayout title={`AI Digest: ${label}`} description={`The AI Digest for ${label}: the most important AI developments, synthesized from dozens of sources.`} type="article" publishedTime={d.date}>
  <DigestEdition date={d.date} windowLabel={d.window} sources={d.sources} articles={d.articles} points={d.points} />
</SiteLayout>
