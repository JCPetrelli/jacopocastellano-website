---
// JC-827 — AI Digest archive.
import SiteLayout from '../../../layouts/redesign/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { P, fmtLong } from '../../../layouts/redesign/paths';
import '../../../styles/redesign/digest.css';

const entries = (await getCollection('aiDigest')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<SiteLayout title="AI Digest Archive" description="Past editions of the AI Digest: the most important AI developments, synthesized and dated.">
  <link slot="head" rel="alternate" type="application/rss+xml" title="AI Digest" href="/ai-digest/rss.xml" />
  <section class="pg-hero">
    <div class="wrap">
      <span class="label">AI Digest · Archive · {entries.length} editions</span>
      <h1>Past editions</h1>
      <div class="pg-intro">
        <p>Every edition of the digest, newest first.</p>
        <div class="pg-actions"><a class="pill" href={`${P}/ai-digest/`}>Latest digest &rarr;</a></div>
      </div>
    </div>
  </section>
  <section class="pg-body">
    <div class="wrap rows">
      {entries.map((e) => (
        <a class="ar-row" href={`${P}/ai-digest/archive/${e.id}/`}>
          <div>
            <span class="ar-date">{fmtLong(e.data.date)}</span>
            <span class="label">{e.data.sources} sources · {e.data.articles} articles</span>
          </div>
          <ol>{e.data.points.map((pt) => <li>{pt.headline}</li>)}</ol>
        </a>
      ))}
    </div>
  </section>
</SiteLayout>
