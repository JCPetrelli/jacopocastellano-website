---
// JC-827 — AI Digest (latest).
import SiteLayout from '../../layouts/redesign/SiteLayout.astro';
import DigestEdition from '../../components/redesign/DigestEdition.astro';
import { getCollection } from 'astro:content';

const latest = (await getCollection('aiDigest')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
const d = latest.data;
---
<SiteLayout title="AI Digest" description="Everything you need to know about AI, in a 2-minute read. The most important developments, synthesized from dozens of sources and updated every 48 hours." modifiedTime={d.date}>
  <link slot="head" rel="alternate" type="application/rss+xml" title="AI Digest" href="/ai-digest/rss.xml" />
  <DigestEdition date={d.date} windowLabel={d.window} sources={d.sources} articles={d.articles} points={d.points} isLatest />
</SiteLayout>
