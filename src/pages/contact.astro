---
// JC-827 — contact.
import SiteLayout from '../layouts/redesign/SiteLayout.astro';
---
<SiteLayout title="Contact" description="Get in touch for collaborations, projects, or just to say hello.">
  <section class="pg-hero">
    <div class="wrap">
      <span class="label">Contact</span>
      <h1>Get in touch</h1>
      <div class="pg-intro">
        <p>Have a project in mind? Want to collaborate? Or just want to say hello? I'd love to hear from you.</p>
      </div>
    </div>
  </section>
  <section class="pg-body">
    <div class="wrap ct-grid">
      <form action="https://formspree.io/f/meekknwy" method="POST">
        <div class="field"><label for="name">Name</label><input type="text" id="name" name="name" required /></div>
        <div class="field"><label for="email">Email</label><input type="email" id="email" name="email" required /></div>
        <div class="field">
          <label for="subject">Subject</label>
          <select id="subject" name="subject" required>
            <option value="">Select a topic</option>
            <option value="software">Software Engineering Project</option>
            <option value="video">Video Design Project</option>
            <option value="collaboration">Collaboration</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="field"><label for="message">Message</label><textarea id="message" name="message" rows="6" required></textarea></div>
        <button type="submit" class="pill ct-send">Send message</button>
      </form>
      <aside class="ct-aside">
        <span class="label">Digital assistant</span>
        <p>Want to talk with my digital assistant instead? Just write to <a href="mailto:piscubot@gmail.com">piscubot@gmail.com</a></p>
      </aside>
    </div>
  </section>
</SiteLayout>

<style>
  .ct-grid { display: grid; grid-template-columns: 7fr 4fr; gap: 80px; align-items: start; }
  .ct-send { margin-top: 48px; }
  .ct-aside { border-top: 1px solid var(--hairline); padding-top: 20px; }
  .ct-aside p { margin-top: 14px; font-size: 22px; font-weight: 300; line-height: 1.35; }
  .ct-aside a { border-bottom: 1px solid var(--border); }
  @media (max-width: 860px) { .ct-grid { grid-template-columns: 1fr; gap: 64px; } }
</style>
