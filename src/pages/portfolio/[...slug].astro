---
// JC-827 — project page.
import SiteLayout from '../../layouts/redesign/SiteLayout.astro';
import { getCollection, render } from 'astro:content';
import { P, categoryLabel } from '../../layouts/redesign/paths';
import '../../styles/redesign/portfolio.css';
import { imageSize } from '../../components/redesign/imageSize';

export async function getStaticPaths() {
  const projects = await getCollection('portfolio');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, date, category, thumbnail, images, video, tags, client, role } = project.data;
const meta = [
  { k: 'Date', v: date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' }) },
  { k: 'Category', v: categoryLabel[category] ?? category },
  client && { k: 'Client', v: client },
  role && { k: 'Role', v: role },
].filter(Boolean) as { k: string; v: string }[];

const imageURL = new URL(thumbnail, Astro.site).toString();
const schema = {
  '@context': 'https://schema.org',
  '@type': category === 'software' ? 'SoftwareApplication' : 'CreativeWork',
  name: title, description, image: imageURL, dateCreated: date.toISOString(),
  creator: { '@type': 'Person', name: 'Jacopo Castellano' },
  ...(client && { provider: { '@type': 'Organization', name: client } }),
  ...(video && { video: { '@type': 'VideoObject', name: title, description, thumbnailUrl: imageURL, uploadDate: date.toISOString(), embedUrl: video } }),
  keywords: tags.join(', '),
  url: new URL(`/portfolio/${project.id}/`, Astro.site).toString(),
};
const thumbSize = await imageSize(thumbnail);
const all = (await getCollection('portfolio')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const next = all[(all.findIndex((p) => p.id === project.id) + 1) % all.length];
---
<SiteLayout title={title} description={description} image={thumbnail} tags={tags}
  breadcrumbs={[{ name: 'Portfolio', url: '/portfolio/' }, { name: title, url: '' }]}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article>
    <header class="pg-hero">
      <div class="wrap">
        <a href={`${P}/portfolio/`} class="back">&larr; Work</a>
        <h1 class="pj-title">{title}</h1>
        <div class="pg-intro">
          <p>{description}</p>
          {tags.length > 0 && <div class="tags pj-tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>}
        </div>
        <dl class="pj-meta">
          {meta.map((m) => <div><dt class="label">{m.k}</dt><dd>{m.v}</dd></div>)}
        </dl>
      </div>
    </header>

    <div class="wrap pj-media">
      {video ? (
        <div class="pj-video"><iframe src={video} title={title} allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe></div>
      ) : (
        <img src={thumbnail} alt={title} width={thumbSize?.w} height={thumbSize?.h}
          style={thumbSize && thumbSize.w < 1000 ? `max-width:min(100%,${Math.round(thumbSize.w * 1.5)}px)` : undefined} />
      )}
    </div>

    <div class="wrap pg-body pj-body"><div class="prose"><Content /></div></div>

    {images && images.length > 0 && (
      <div class="wrap pj-gallery">
        {images.map((img, i) => (
          <button class="pj-shot" data-lightbox={i} aria-label={`Open image ${i + 1}`}><img src={img} alt={`${title} detail`} loading="lazy" /></button>
        ))}
      </div>
    )}

    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Image viewer" hidden>
      <button class="lb-close" aria-label="Close">Close</button>
      <button class="lb-prev" aria-label="Previous">&larr;</button>
      <button class="lb-next" aria-label="Next">&rarr;</button>
      <img class="lb-img" alt="" />
    </div>
  </article>

  {next && next.id !== project.id && (
    <section class="on-dark pj-next">
      <a href={`${P}/portfolio/${next.id}/`} class="wrap">
        <span class="label">Next project</span>
        <h2>{next.data.title} &rarr;</h2>
      </a>
    </section>
  )}
</SiteLayout>

<script>
  import { initYtFacades } from '../../scripts/ytFacade';
  initYtFacades();
  const lb = document.getElementById('lightbox')!;
  const lbImg = lb.querySelector<HTMLImageElement>('.lb-img')!;
  const shots = Array.from(document.querySelectorAll<HTMLElement>('.pj-shot'));
  const srcs = shots.map((s) => s.querySelector('img')!.src);
  let cur = 0;
  let opener: HTMLElement | null = null;
  const show = (i: number) => {
    cur = (i + srcs.length) % srcs.length; lbImg.src = srcs[cur]; lbImg.alt = `Image ${cur + 1} of ${srcs.length}`;
    if (lb.hidden) { opener = document.activeElement as HTMLElement; lb.hidden = false; lb.classList.add('open'); document.body.style.overflow = 'hidden'; lb.querySelector<HTMLElement>('.lb-close')?.focus(); }
  };
  const close = () => { lb.classList.remove('open'); lb.hidden = true; document.body.style.overflow = ''; opener?.focus(); };
  shots.forEach((s) => s.addEventListener('click', () => show(Number(s.dataset.lightbox))));
  lb.querySelector('.lb-close')?.addEventListener('click', close);
  lb.querySelector('.lb-prev')?.addEventListener('click', () => show(cur - 1));
  lb.querySelector('.lb-next')?.addEventListener('click', () => show(cur + 1));
  lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
  document.addEventListener('keydown', (e) => {
    if (!lb.classList.contains('open')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') show(cur - 1);
    if (e.key === 'ArrowRight') show(cur + 1);
    if (e.key === 'Tab') { // keep focus inside the viewer
      const b = Array.from(lb.querySelectorAll<HTMLElement>('button'));
      const i = b.indexOf(document.activeElement as HTMLElement);
      e.preventDefault(); b[(i + (e.shiftKey ? -1 : 1) + b.length) % b.length].focus();
    }
  });
</script>
