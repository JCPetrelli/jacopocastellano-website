---
// JC-827 — portfolio list.
import SiteLayout from '../../layouts/redesign/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { P, categoryLabel } from '../../layouts/redesign/paths';
import '../../styles/redesign/portfolio.css';
import WorkList from '../../components/redesign/WorkList.astro';

const projects = (await getCollection('portfolio')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const categories = ['all', 'video', 'software', 'motion', 'installation'];
const count = (c: string) => (c === 'all' ? projects.length : projects.filter((p) => p.data.category === c).length);
---
<SiteLayout title="Portfolio" description="A collection of video design, software, and creative projects.">
  <section class="pg-hero">
    <div class="wrap">
      <span class="label">Work · {projects.length} projects</span>
      <h1>Video design, software, motion and installations.</h1>
      <div class="pg-intro">
        <p>Selected works spanning video design, software engineering, motion graphics, and interactive installations.</p>
        <nav class="pg-actions" aria-label="Filter projects">
          {categories.map((c) => (
            <button class="pill" data-filter={c} aria-pressed={c === 'all' ? 'true' : 'false'}>
              {c === 'all' ? 'All' : categoryLabel[c]} <span class="pf-count">{count(c)}</span>
            </button>
          ))}
        </nav>
      </div>
    </div>
  </section>

  <section class="pg-body">
    <div class="wrap">
      <WorkList items={projects} size="md" />
    </div>
  </section>
</SiteLayout>

<script is:inline>
  document.querySelectorAll('[data-filter]').forEach((btn) => btn.addEventListener('click', () => {
    const f = btn.dataset.filter;
    document.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    document.querySelectorAll('.wl-list > li').forEach((c) => { c.hidden = f !== 'all' && c.dataset.category !== f; });
  }));
</script>
